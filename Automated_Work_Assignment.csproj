<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RimWorld mod assembly.

    Builds against Krafs.Rimworld.Ref (reference-only game assemblies pulled from
    NuGet), so a clean checkout compiles with nothing but the .NET SDK installed -
    no local RimWorld install, no hand-wired HintPaths.

    Pick the target game version through the configuration name:
        dotnet build "-p:Configuration=Debug 1.6"
        dotnet build "-p:Configuration=Release 1.5"
    A bare "Debug"/"Release" (or no Configuration at all) defaults to RimWorld 1.6.

    RimWorld 1.7 is the exception: it dropped Unity/Mono for Ludeon's own engine on a
    custom .NET 10 CoreCLR, and there is no reference package for it. "Debug 1.7" /
    "Release 1.7" therefore build against net10.0 using the DLLs of the local install
    (Assembly-CSharp.dll and UnityStubs.dll sit in the game root) plus Harmony's 1.7
    build from the Steam Workshop. Needs the .NET 10 SDK. Override the paths with
        -p:RimWorldDir=...   -p:HarmonyDir=...
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Automated_Work_Assignment</AssemblyName>
    <RootNamespace>Automated_Work_Assignment</RootNamespace>
    <Configurations>Debug 1.5;Release 1.5;Debug 1.6;Release 1.6;Debug 1.7;Release 1.7</Configurations>

    <!-- Keep the hand-maintained Properties/AssemblyInfo.cs instead of a generated one -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <!-- RimWorld loads a bare DLL: no .deps.json, and never copy NuGet refs next to it -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- Map the four "<Debug|Release> <version>" configurations onto a game version -->
  <PropertyGroup>
    <RimWorldVersion Condition="$(Configuration.Contains('1.5'))">1.5</RimWorldVersion>
    <RimWorldVersion Condition="$(Configuration.Contains('1.7'))">1.7</RimWorldVersion>
    <RimWorldVersion Condition="'$(RimWorldVersion)' == ''">1.6</RimWorldVersion>
  </PropertyGroup>

  <!-- SDK already defines TRACE for every configuration, and DEBUG only for a bare
       "Debug"; add DEBUG back for the "Debug <version>" configs the code's #if DEBUG needs. -->
  <PropertyGroup Condition="$(Configuration.StartsWith('Release'))">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <PropertyGroup Condition="!$(Configuration.StartsWith('Release'))">
    <DefineConstants>$(DefineConstants);DEBUG</DefineConstants>
    <Optimize>false</Optimize>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldVersion)' == '1.5'">
    <DefineConstants>$(DefineConstants);RIMWORLD_1_5</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RimWorldVersion)' == '1.6'">
    <DefineConstants>$(DefineConstants);RIMWORLD_1_6</DefineConstants>
  </PropertyGroup>
  <!-- 1.7 keeps the 1.6 Listing_Standard API, so it also takes the RIMWORLD_1_6 code paths -->
  <PropertyGroup Condition="'$(RimWorldVersion)' == '1.7'">
    <TargetFramework>net10.0</TargetFramework>
    <DefineConstants>$(DefineConstants);RIMWORLD_1_6;RIMWORLD_1_7</DefineConstants>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\RimWorld</RimWorldDir>
    <HarmonyDir Condition="'$(HarmonyDir)' == ''">$(RimWorldDir)\..\..\workshop\content\294100\2009463077\1.7\Assemblies</HarmonyDir>
  </PropertyGroup>

  <!-- Output into <repo>/<version>/Assemblies so the repo folder itself is a loadable mod -->
  <PropertyGroup>
    <OutputPath>$(MSBuildProjectDirectory)\$(RimWorldVersion)\Assemblies\</OutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);1.5\**;1.6\**;1.7\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.3.5" Condition="'$(RimWorldVersion)' != '1.7'" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.5.*" Condition="'$(RimWorldVersion)' == '1.5'" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.*" Condition="'$(RimWorldVersion)' == '1.6'" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <!-- 1.7: reference the installed game and Harmony directly; never copy them next to the mod DLL -->
  <ItemGroup Condition="'$(RimWorldVersion)' == '1.7'">
    <Reference Include="Assembly-CSharp" HintPath="$(RimWorldDir)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="UnityStubs" HintPath="$(RimWorldDir)\UnityStubs.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(HarmonyDir)\0Harmony.dll" Private="false" />
  </ItemGroup>
  <Target Name="CheckRimWorld17References" BeforeTargets="ResolveAssemblyReferences" Condition="'$(RimWorldVersion)' == '1.7'">
    <Error Condition="!Exists('$(RimWorldDir)\Assembly-CSharp.dll')" Text="RimWorld 1.7 not found in '$(RimWorldDir)'. Pass -p:RimWorldDir=&lt;path to RimWorld&gt;." />
    <Error Condition="!Exists('$(HarmonyDir)\0Harmony.dll')" Text="Harmony for 1.7 not found in '$(HarmonyDir)'. Subscribe to Harmony on the Workshop or pass -p:HarmonyDir=..." />
  </Target>

  <!--
    Optional convenience: mirror About/ + Languages/ and drop the freshly built
    assembly into a local RimWorld install. Automatically skipped when that folder
    is absent (CI, other machines, no Steam), so it never breaks a plain build.
    Override with:  dotnet build "-p:Configuration=Debug 1.6" -p:ModDeployDir=...
  -->
  <PropertyGroup>
    <ModDeployDir Condition="'$(ModDeployDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\RimWorld\Mods\Automated_Work_Assignment</ModDeployDir>
  </PropertyGroup>
  <Target Name="DeployModContent" AfterTargets="Build" Condition="'$(ModDeployDir)' != '' And Exists('$(ModDeployDir)')">
    <Exec Command="robocopy &quot;$(ProjectDir)About&quot; &quot;$(ModDeployDir)\About&quot; /MIR /NJH /NJS /NFL /NDL" IgnoreExitCode="true" />
    <Exec Command="robocopy &quot;$(ProjectDir)Languages&quot; &quot;$(ModDeployDir)\Languages&quot; /MIR /NJH /NJS /NFL /NDL" IgnoreExitCode="true" />
    <Exec Command="robocopy &quot;$(OutputPath.TrimEnd('\'))&quot; &quot;$(ModDeployDir)\$(RimWorldVersion)\Assemblies&quot; Automated_Work_Assignment.dll Automated_Work_Assignment.pdb /NJH /NJS /NFL /NDL" IgnoreExitCode="true" />
  </Target>

</Project>
